# ============================================
# IMAGE STUDIO - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# JWT CONFIGURATION
# ============================================
# IMPORTANT: Change this to a secure random string in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ============================================
# DATABASE
# ============================================
# SQLite database will be stored in ./data/users.db

DATABASE_URL=postgresql://neondb_owner:npg_NFyfjOxJpg78@ep-nameless-mode-a1j6bdmy-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_SSL=true

# ============================================
# EMAIL (SMTP) CONFIGURATION
# ============================================
# Required for email verification and password reset

# Gmail (Development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=amirhsl@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
# For SendGrid: SMTP_USER=apikey, SMTP_PASS=your-api-key
# For Mailgun: SMTP_HOST=smtp.mailgun.org

# ============================================
# STRIPE (PAYMENTS) CONFIGURATION
# ============================================
# Required for subscription payments

# API Keys (use test keys for development)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Price IDs (create in Stripe Dashboard → Products)
STRIPE_PRO_MONTHLY_PRICE=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRO_YEARLY_PRICE=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_BUSINESS_MONTHLY_PRICE=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_BUSINESS_YEARLY_PRICE=price_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# CLOUDINARY (OPTIONAL - Cloud Storage)
# ============================================
# Required for production image storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ==========================================
# Serverless GPU Provider Config
# ==========================================

# Choose which GPU provider backend to use:
# 'local'     - Runs realesrgan-ncnn-vulkan.exe on your local machine (default)
# 'modal'     - Calls a serverless Modal endpoint (Free $30/mo tier)
# 'replicate' - Calls Replicate.com API ($0.002/img)
GPU_PROVIDER=modal

# Required if GPU_PROVIDER=modal
# Sign up at https://modal.com, deploy your function, and grab the URL
MODAL_ENDPOINT_URL=https://amirshamim412--realesrgan-api-upscale.modal.run
MODAL_API_TOKEN=ak-iM3lbuSZYGUi2weU6GTF5w

# Required if GPU_PROVIDER=replicate
# Sign up at https://replicate.com
REPLICATE_API_TOKEN=your_replicate_api_token_here
