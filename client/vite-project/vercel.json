{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://image-studio-5yqqy.ondigitalocean.app/api/:path*"
    },
    {
      "source": "/profile_pictures/:path*",
      "destination": "https://image-studio-5yqqy.ondigitalocean.app/profile_pictures/:path*"
    },
    {
      "source": "/processed/:path*",
      "destination": "https://image-studio-5yqqy.ondigitalocean.app/processed/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}